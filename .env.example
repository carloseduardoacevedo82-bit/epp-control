# ==============================================================================
# VARIABLES DE ENTORNO - SISTEMA DE CONTROL DE EPPS Y UNIFORMES
# DALUPEZMAR S.A.C.
# ==============================================================================

# Entorno de ejecución (development | production)
NODE_ENV=production

# Puerto en el que correrá la aplicación (automático en Render / Railway / Docker)
PORT=3000

# Hostname para enlace de red en contenedores
HOSTNAME="0.0.0.0"

# ------------------------------------------------------------------------------
# 1. OPCIONES DE BASE DE DATOS (Elige una según tu preferencia de despliegue)
# ------------------------------------------------------------------------------

# OPCIÓN A: Base de datos PostgreSQL en la nube (Recomendado: Supabase / Railway / Render / Neon)
# DATABASE_URL="postgresql://postgres:TU_PASSWORD_AQUI@db.tu-proyecto.supabase.co:5432/postgres"
# DATABASE_URL="postgresql://postgres:password@ep-cool-river-12345.us-east-1.aws.neon.tech/neondb?sslmode=require"

# OPCIÓN B: Base de datos Serverless en Turso (LibSQL Cloud - Gratis y 100% persistente)
# DATABASE_URL="libsql://tu-base-de-datos.turso.io"
# TURSO_AUTH_TOKEN="tu_token_de_autenticacion_turso"

# OPCIÓN C: SQLite con disco/volumen persistente (Docker / Render Disk / Railway Volume)
# DATABASE_URL="file:/app/data/epp.db"

# OPCIÓN D: SQLite local para desarrollo en PC
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. ALMACENAMIENTO DE CONSTANCIAS Y REPORTES PDF
# ------------------------------------------------------------------------------
# Ruta absoluta para guardar constancias PDF en un volumen persistente.
# Si se deja vacío, se guardará por defecto en 'public/constancias'.
# Nota: La base de datos guarda las firmas digitales en Base64 y todos los datos,
# por lo que los PDFs también pueden regenerarse en tiempo real sin pérdida de información.
STORAGE_PATH="/app/data/constancias"

# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y CLAVES SECRETAS
# ------------------------------------------------------------------------------
# Llave secreta para sesiones, firma de tokens o APIs futuras
APP_SECRET="cambia_este_valor_por_una_clave_segura_de_al_menos_32_caracteres"

# Dominio público configurado en producción (útil para links en reportes)
NEXT_PUBLIC_APP_URL="https://tu-app.onrender.com"
